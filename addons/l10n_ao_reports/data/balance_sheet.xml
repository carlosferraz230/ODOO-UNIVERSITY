<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="account_financial_report_line_ao_balanco" model="account.financial.html.report">
        <field name="name">Balanço</field>
        <field name="unfold_all_filter" eval="True"/>
        <field name="date_range" eval="False"/>
        <field name="show_journal_filter" eval="True"/>
        <field name='parent_id' ref='l10n_ao.account_reports_ao_statements_menu'/>
        <field name="country_id" ref="base.ao"/>
    </record>

    <record id="account_financial_report_line_ao_balanco_ativo" model="account.financial.html.report.line">
        <field name="name">ACTIVO</field>
        <field name="code">ACTIVO</field>
        <field name="level" eval="1"/>
        <field name="sequence" eval="1"/>
        <field name="financial_report_id" ref="account_financial_report_line_ao_balanco"/>
        <field name="formulas">ANC + AC</field>
    </record>

    <record id="account_financial_report_line_ao_balanco_ativo_nao_corrente" model="account.financial.html.report.line">
        <field name="name">Activo não corrente</field>
        <field name="code">ANC</field>
        <field name="level" eval="2"/>
        <field name="sequence" eval="1"/>
        <field name="parent_id" ref="account_financial_report_line_ao_balanco_ativo"/>
        <field name="formulas">IC + II + ISA + OANC</field>
    </record>

    <record id="account_financial_report_l10n_ao_balanco_imobilizacoes_corporeas" model="account.financial.html.report.line">
        <field name="name">Imobilizações corpóreas</field>
        <field name="code">IC</field>
        <field name="level" eval="3"/>
        <field name="sequence" eval="1"/>
        <field name="parent_id" ref="account_financial_report_line_ao_balanco_ativo_nao_corrente"/>
        <field name="formulas">-sum</field>
        <field name="domain" eval="[('account_id.code', '=like', '11%')]"/>
    </record>

    <record id="account_financial_report_line_ao_balanco_imobilizacoes_incorporeas" model="account.financial.html.report.line">
