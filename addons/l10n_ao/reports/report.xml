<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="sale.action_report_saleorder" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="sale.action_report_saleorder" model="ir.actions.report">
            <field name="name">Orçamento</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_ao.report_sale_ao</field>
            <field name="report_file">l10n_ao.report_sale_ao</field>
            <field name="print_report_name">'ORÇAMENTO - %s' % (object.name)</field>
            <field name="binding_type">report</field>
        </record>
        <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
            <field name="name">PRO-FORMA</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_ao.report_invoice_pro_forma_ao</field>
            <field name="report_file">l10n_ao.report_invoice_pro_forma_ao</field>
            <field name="print_report_name">'PRO-FORMA - %s' % (object.name)</field>
            <field name="binding_type">report</field>
            <field name="groups_id" eval="[(4, ref('sale.group_proforma_sales'))]"/>
        </record>

        <record id="account.account_invoices" model="ir.actions.report">
            <field name="report_name">l10n_ao.report_invoice_l10n_ao</field>
            <field name="report_file">l10n_ao.report_invoice_l10n_ao</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
        </record>
        <record id="account.action_report_payment_receipt" model="ir.actions.report">
            <field name="report_name">l10n_ao.report_payment_receipt_ao</field>
            <field name="report_file">l10n_ao.report_payment_receipt_ao</field>
        </record>
        <record id="account.action_account_original_vendor_bill" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="account.account_invoices_without_payment" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>


    </data>
</odoo>