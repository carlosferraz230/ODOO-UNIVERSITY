<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ==========================================================
                            CATEGORIA
        ========================================================== -->
        <record id="module_category_fleet_management" model="ir.module.category">
            <field name="name">Gestão de Frota</field>
            <field name="description">Módulo de Gestão de Frota</field>
            <field name="sequence">10</field>
        </record>

        <!-- ==========================================================
                        GRUPO: UTILIZADOR
        ========================================================== -->
        <record id="group_fleet_user" model="res.groups">
            <field name="name">Utilizador de Frota</field>
            <field name="category_id" ref="module_category_fleet_management"/>

            <!-- Utilizador interno -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- ==========================================================
                        GRUPO: GESTOR
        ========================================================== -->
        <record id="group_fleet_manager" model="res.groups">
            <field name="name">Gestor de Frota</field>
            <field name="category_id" ref="module_category_fleet_management"/>

            <!-- Herda permissões do utilizador -->
            <field name="implied_ids" eval="[(4, ref('group_fleet_user'))]"/>
        </record>

        <!-- ==========================================================
                    REGRA: UTILIZADOR VÊ TODOS VEÍCULOS
        ========================================================== -->
        <record id="fleet_vehicle_rule_user_all" model="ir.rule">
            <field name="name">Fleet User - All Vehicles</field>

            <!-- Modelo -->
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>

            <!-- Grupo -->
            <field name="groups" eval="[(4, ref('group_fleet_user'))]"/>

            <!-- Mostrar todos -->
            <field name="domain_force">[(1, '=', 1)]</field>

            <!-- Permissões -->
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- ==========================================================
                DESACTIVAR REGRA ORIGINAL DO ODOO FLEET
        ========================================================== -->
        <record id="fleet.fleet_rule_vehicle_visibility_user" model="ir.rule">
            <field name="active" eval="False"/>
        </record>

    </data>
</odoo>