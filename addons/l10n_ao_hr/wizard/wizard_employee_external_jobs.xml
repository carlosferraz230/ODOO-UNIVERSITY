<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="employee_external_jobs_form_view" model="ir.ui.view">
            <field name="name">wizard.employee.external.jobs.form</field>
            <field name="model">wizard.employee.external.jobs</field>
            <field name="arch" type="xml">
                <form string="Percentagem de Trabalhos Externos do Funcionário">
                    <div class="oe_title">
                        <label for="employee_id"/>
                        <h1>
                            <field name="employee_id" required="1" placeholder="Nome do funcionário."
                                   options="{'no_quick_create': True, 'no_create_edit': True}"
                            />
                        </h1>
                    </div>
                    <group>
                        <field name="employee_contract_id"/>
                        <field name="remuneration_id"/>
                        <label for="percentage"/>
                        <div class="o_row" name="percentage">
                            <field name="percentage" nolabel="1"/>
                            <span>%</span>
                        </div>
                    </group>
                    <group col="4">
                        <field name="start_date" required="1"/>
                        <field name="end_date" required="1"/>
                    </group>

                    <footer>
                        <button name="button_add_remuneration" attrs="{'invisible':[('employee_contract_id','=',False)]}" string="Add Remuneration"
                                type="object" class="oe_highlight"/>
                        or
                        <button string="Cancel Wizard" special="cancel" class="oe_link"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="employee_external_jobs_action" model="ir.actions.act_window">
            <field name="name">Trabalhos externos dos Funcionarios</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wizard.employee.external.jobs</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem name="Trabalhos externos dos Funcionarios" id="employee_external_jobs_menu" parent="hr_attendance.menu_hr_attendance_root"
              groups="hr_payroll.group_hr_payroll_user" sequence="10"
              action="employee_external_jobs_action"/>
    </data>
</odoo>