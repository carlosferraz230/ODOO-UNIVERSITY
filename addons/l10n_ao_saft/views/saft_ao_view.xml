<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="saft_ao_file_export_view" model="ir.ui.view">
            <field name="name">saft.ao.file.export.form</field>
            <field name="model">saft.ao.file.export</field>
            <field name="arch" type="xml">
                <form string="Ficheiro SAFT AO" create="false">
                    <header>
                        <button name="action_validate" string="Validar" type="object"
                                icon="fa-check" attrs="{'invisible':[('state','!=', 'draft')]}" class="oe_highlight"/>
                        <button name="action_download" string="Transferir Arquivo XML" type="object"
                                icon="fa-download" attrs="{'invisible':[('state','!=', 'valid')]}"
                                class="oe_highlight"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Nome"/>
                                <field name="date_from" string="Data Inicial"/>
                                <field name="date_to" string="Data Final"/>
                                <field name="fiscal_year" string="Ano Fiscal" invisible="1"/>
                                <field name="header_comment" string="Comentário"/>
                            </group>
                            <group>
                                <field name="tax_account_Basis" string="Tipo de Documento"/>
                                <field name="create_date" string="Data de Criação"/>
                                <field name="user_id" string="Utilizador"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="xml_content" string="XML">
                                <field name="content_xml" widget="code" string="XML"/>
                            </page>
                            <page string="Product Info" invisible="1">
                                <group>
                                    <group>
                                        <field name="audit_file_version" string="Versão do Arquivo"/>
                                        <field name="product_company_tax_id" string="NIF"/>
                                    </group>
                                    <group>
                                        <field name="product_id" string="Produto"/>
                                        <field name="software_validation_number" string="Certificado"/>
                                        <field name="product_version" string="Versão do Produto"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="saft_ao_file_export_tree_view">
            <field name="name">saft.ao.file.export.list</field>
            <field name="model">saft.ao.file.export</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" string="Nome"/>
                    <field name="date_from" string="Data Inicial"/>
                    <field name="date_to" string="Data Final"/>
                    <field name="company_id" string="Empresa"/>
                    <field name="fiscal_year" invisible="1" string="Ano Fiscal"/>
                    <field name="tax_account_Basis" string="Tipo de Documento"/>
                    <field name="header_comment" invisible="1" string="Comentário"/>
                    <field name="audit_file_version"  string="Versão do Arquivo"/>
                    <field name="create_date" string="Data de criação"/>
                    <field name="user_id" string="Utilizador"/>
                    <field name="state" widget="badge" string="Estado"/>
                </tree>
            </field>
        </record>


        <record id="saft_file_search_view" model="ir.ui.view">
            <field name="name">saft.file.search.view</field>
            <field name="model">saft.ao.file.export</field>
            <field name="arch" type="xml">
                <search string="SAFT file">
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="fiscal_year"/>
                    <field name="tax_account_Basis"/>
                    <field name="header_comment"/>
                    <field name="audit_file_version"/>
                    <field name="create_date"/>
                    <field name="company_id"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <group expand="0" string="Group By">
                        <filter name="State" string="Estado" domain="[]"
                                context="{'group_by':'state'}"
                                help="Group Files for state"/>
                        <filter name="Company" string="Empresas" domain="[]"
                                context="{'group_by':'company_id'}"
                                help="Group Files for Company"/>
                        <filter name="Document Type" string="Tipo de Documento" domain="[]"
                                context="{'group_by':'tax_account_Basis'}"
                                help="Group Files for Document Type"/>
                    </group>

                    <filter name="draft" string="Rascunho" domain="[('state','=','draft')]"/>
                    <filter name="sent" string="Enviado" domain="[('state','=','sent')]"/>
                    <separator/>
                    <filter name="I" string="Contablidade integrada com facturação"
                            domain="[('tax_account_Basis','=','I')]"/>
                    <filter name="C" string="Contablidade" domain="[('tax_account_Basis','=','C')]"/>
                    <filter name="F" string="Facturação" domain="[('tax_account_Basis','=','F')]"/>
                    <filter name="S" string="Autofacturação" domain="[('tax_account_Basis','=','S')]"/>
                    <filter name="Q" string="Aquisição de bens e serviços integrada com a facturação"
                            domain="[('tax_account_Basis','=','Q')]"/>
                    <filter name="P" string="Facturação parcial"
                            domain="[('tax_account_Basis','=','P')]"/>
                    <filter name="R" string="Recibos"
                            domain="[('tax_account_Basis','=','R')]"/>
                    <filter name="A" string="Aquisição de bens e serviços"
                            domain="[('tax_account_Basis','=','A')]"/>

                    <separator/>
                    <!--  <filter name="date_from" string="Date Start" context="{'group_by': 'date_from'}"/>
                      <filter name="date_to" string="Date End" context="{'group_by': 'date_to'}"/>-->


                </search>
            </field>

        </record>

        <record id="saft_ao_file_action" model="ir.actions.act_window">
            <field name="name">Ficheiro XML SAFT</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">saft.ao.file.export</field>
            <field name="view_mode">tree,form</field>
            <field name="target">current</field>
        </record>

        <menuitem name="SAFT AO" parent="account_accountant.menu_accounting" id="menu_saft_ao" sequence="5"/>
        <menuitem id="saft_ao_file" name="Ficheiro Exportado" parent="menu_saft_ao" action="saft_ao_file_action"/>
    </data>
</odoo>