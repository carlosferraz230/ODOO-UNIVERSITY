<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="seq_receivable_account_account" model="ir.sequence">
            <field name="name">Conta Cliente</field>
            <field name="code">receivable.account</field>
            <field eval="4" name="padding"/>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>

        </record>
        <record id="seq_payable_account_account" model="ir.sequence">
            <field name="name">Conta Fornecedor</field>
            <field name="code">payable.account</field>
            <field eval="4" name="padding"/>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_customer_invoice_account_payment_ao" model="ir.sequence">
            <field name="name">Recibo de Faturas clientes</field>
            <field name="code">account.payment.customer</field>
            <field name="prefix">RG %(year)s/</field>
            <field name="padding">1</field>
        </record>

        <record id="seq_pp_sale_order" model="ir.sequence">
            <field name="name">Sales Order</field>
            <field name="code">pp.sale.order</field>
            <field name="prefix">PP %(year)s/</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_or_sale_order" model="ir.sequence">
            <field name="name">Orçamento Ordem de Vendas</field>
            <field name="code">or.sale.order</field>
            <field name="prefix">OR %(year)s/</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_picking_ao" model="ir.sequence">
            <field name="name">Guia de remessa e transporte</field>
            <field name="code">stock.picking.ao</field>
            <field name="prefix">%(year)s/</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

</odoo>