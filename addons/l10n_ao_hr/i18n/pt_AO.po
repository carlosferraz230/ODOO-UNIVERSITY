"O Trabalhador desempenhará as suas funções nas instalações da Empregadora\n"
"na província de XXX."
msgstr ""

#. module: l10n_ao_hr
#: model_terms:ir.ui.view,arch_db:l10n_ao_hr.report_contract_determinado_pdf
