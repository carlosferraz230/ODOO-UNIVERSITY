<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- action invoices -->
        <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
            <field name="domain">[('move_type','in',['out_invoice']),('journal_id.code','in',['FT','FT C'] )]</field>
        </record>

        <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
            <field name="domain">[('move_type','in',['in_invoice']),('journal_id.code','in',['FT','FT BI'])]</field>
        </record>

        <record id="action_move_fr_out_invoice_type" model="ir.actions.act_window">
            <field name="name">Faturas Recibo de Cliente</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_out_invoice_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type','in',['out_invoice']),('journal_id.code','in',['FR','FR C'])]</field>
            <field name="context">{'default_move_type':'out_invoice','default_receipt_type':'sale'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crie uma fatura recibo para o cliente
                </p>
                <p>
                    Crie faturas, registe pagamentos e acompanhe as discussões com os seus clientes.
                </p>
            </field>
        </record>

        <record id="action_move_fr_in_invoice_type" model="ir.actions.act_window">
            <field name="name">Faturas Recibo de Fornecedor</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type','in',['in_invoice','in_refund']),('journal_id.code', 'in', ['FR','FR F'] )]</field>
            <field name="context">{'default_move_type':'in_invoice','default_receipt_type':'purchase'}</field>
            <field name="help" type="html">
                <!-- An owl component should be displayed instead -->
                <p class="o_view_nocontent_smiling_face">
                    Crie uma fatura recibo para o fornecedor
                </p>
                <p>
                    Crie faturas, registe pagamentos e acompanhe as discussões com os seus fornecedores.
                </p>
            </field>
        </record>


        <!-- menu -->
        <menuitem id="menu_action_move_out_fr_invoice_type"
                  name="Faturas Recibo" parent="account.menu_finance_receivables"
                  groups="res_groups_invoice_receipt"
                  action="action_move_fr_out_invoice_type" sequence="1"/>

        <menuitem id="menu_action_move_fr_in_invoice_type"
                  name="Faturas Recibo" parent="account.menu_finance_payables"
                  groups="res_groups_invoice_receipt"
                  action="action_move_fr_in_invoice_type" sequence="1"/>

    </data>
</odoo>